{
  "console": {
    "workspace_name": "고객사 이름 구독",
    "subscription_name": "구독 표시 이름",
    "inventory_scope": "subscription",
    "archive_mode": "blob",
    "restore_enabled": false,
    "activity_days": 2
  },
  "capture": {
    "subscriptions": ["00000000-0000-0000-0000-000000000002"],
    "resource_groups": ["rg-armbackup-storage"],
    "discovery_tables": ["Resources"],
    "exclude_types": [],
    "api_versions": {
      "microsoft.network/networksecuritygroups": "2024-05-01",
      "microsoft.network/routetables": "2024-05-01",
      "microsoft.network/virtualnetworks": "2024-05-01"
    },
    "collections": {},
    "workers": 3,
    "retries": 4,
    "timeout_seconds": 60,
    "credential": "managed_identity",
    "storage": {
      "account_url": "https://stcustomerbackup.blob.core.windows.net",
      "container": "armbackup",
      "prefix": "armbackup",
      "require_private_endpoint": true
    }
  }
}
